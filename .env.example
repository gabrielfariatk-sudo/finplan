# Copie para .env.local
# Segredo da sessão (opcional: se vazio, é gerado em data/auth-secret.key). Gere com: openssl rand -hex 32
AUTH_SECRET=

# URL usada no link do e-mail de recuperação de senha
APP_URL=http://localhost:3000

# Defina true somente se servir o app via HTTPS
COOKIE_SECURE=false

# E-mail de recuperação (SMTP). Sem isso, o link aparece no terminal onde o Next está rodando.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=senha-de-app
MAIL_FROM="FinPlan <seu-email@gmail.com>"

# Guardar o banco FORA da pasta do código (recomendado em uso diário). Descomente e ajuste:
# DB_PATH=C:\FinPlanDados\finplan.db
